# ── Database (MS SQL Server) ──────────────────────────────────────────────────
# Windows Authentication (Trusted_Connection) — recommended for local/on-prem
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=nss_db
DB_TRUST_CERT=true

# SQL Server Auth — use this for production/Azure (disable trusted conn above)
# DB_TRUST_CERT=false
# DB_USER=nss_app
# DB_PASSWORD=YourStrong!Passw0rd#2024

# ── Application ───────────────────────────────────────────────────────────────
# ⚠️  CHANGE THIS before deploying! Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS

PORT=5000
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins (production)
ALLOWED_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Email (choose ONE of the two options below) ───────────────────────────────

# Option 1 — Resend (paid, ~100 free emails/day)
# Sign up at https://resend.com and verify your domain
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=nssrscoe073@gmail.com

# Option 2 — Gmail via App Password (FREE, recommended for self-hosted)
# 1. Enable 2-Step Verification on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password (select "Mail" + "Other")
# 4. Paste the 16-character password below (no spaces)
GMAIL_USER=nssrscoe073@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
