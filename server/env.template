# ==========================================
# Azure Deployment - Environment Variables
# ==========================================
# Copy this file to .env for local development.
# In Azure, inject these into App Service "Environment Variables" or Container Apps.

# Node Environment (set to 'production' in Azure)
NODE_ENV=production

# Server Port (Azure App Service defaults to 8080, Container Apps can use 5000)
PORT=8080

# ==========================================
# Database Configuration (Azure SQL / MSSQL)
# ==========================================
# The fully qualified domain name of your Azure SQL server (e.g., myserver.database.windows.net)
DB_SERVER=your-azure-sql-server-name.database.windows.net
DB_DATABASE=nss_db
DB_USER=your_db_username
DB_PASSWORD=your_super_secret_password

# Must be 'true' for Azure SQL
DB_TRUST_CERT=false 

# ==========================================
# Authentication & Security
# ==========================================
# Generate a strong random string (e.g., using `openssl rand -hex 64`)
JWT_SECRET=your_super_secret_jwt_key

# Optional: Set this to true to enable strict XSS filters (handled by Helmet CSP)
# ENFORCE_STRICT_SECURITY=true
